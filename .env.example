# EMS Web Client Environment Variables
# Copy this file to .env and configure

# API Configuration
VITE_API_BASE_URL=/api/v1
VITE_AI_API_BASE_URL=/api/v1/ai
VITE_WS_URL=ws://localhost:8080

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_AI_ASSISTANT=true

# Third-party Services
VITE_SUPERSET_URL=http://localhost:8088
VITE_OPENMETADATA_URL=http://localhost:8585

# App Configuration
VITE_APP_NAME=EMS Platform
VITE_APP_VERSION=1.0.0
